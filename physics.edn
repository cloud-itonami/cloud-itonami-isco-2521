;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; ISCO 2521, database designers and administrators. The README calls this pure-cognitive work with no robotics
;; gate; blueprint.edn nevertheless declares :itonami.blueprint/robotics true.
;; The physical work declared here is the handling the occupation itself
;; entails (ASSUMPTION, not stated in the README): loading backup-tape magazines into the tape library, carrying the rotated tapes to the media safe, and the media safe's wall during a building fire.
;; Replace with the README premise once one is written.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-2521"
 :cases
 [{:id :tape-magazine-into-library
   :kind :manipulator
   :procedure "arm lifts a loaded backup-tape magazine from the cart into the tape library's import slot"
   :params {:l1-m 0.40 :l2-m 0.35 :m1-kg 3.0 :m2-kg 2.0
            :from [0.45 -0.10] :to [0.30 0.45] :duration-s 1.5 :steps 500}
   :sweep {:param :payload-kg :values [0.5 1.5 2.5 4.0 6.0]}
   :quantity :peak-tau1-nm
   :limit {:max 40.0 :basis "estimate: continuous shoulder torque of a light collaborative arm (~3 kg class)"}
   :boundary {:lo 0.1 :hi 20.0}}
  {:id :tape-rotation-to-safe
   :kind :transport
   :procedure "AMR carries the week's rotated backup tapes from the server room to the media safe in the records vault"
   :params {:mass-kg 30.0 :payload-kg 8.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.7 :drive-force-n 60.0 :crr 0.02
            :cog-height-m 0.50 :support-half-length-m 0.22}
   :sweep {:param :distance-m :values [20.0 40.0 70.0 100.0 140.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: tapes out of controlled storage for at most 90 s per leg"}
   :boundary {:lo 5.0 :hi 300.0}}
  {:id :media-safe-wall-fire
   :kind :thermal
   :procedure "one-hour building fire acts on the insulated wall of the media safe holding backup tapes"
   :params {:conductivity-w-mk 0.20 :density-kg-m3 900.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 927.0 :h-front-w-m2k 50.0 :t-back-ambient-c 20.0 :h-back-w-m2k 5.0
            :threshold-c 52.0 :duration-s 3600.0 :nodes 21}
   :sweep {:param :thickness-m :values [0.04 0.06 0.08 0.10 0.14]}
   :quantity :final-back-c
   :limit {:max 52.0 :basis "UL 72 Class 125 (magnetic media): interior must not exceed 125 F (52 C) during the rated exposure; 927 C is the ASTM E119 furnace temperature at 60 min, held constant here (estimate: constant exposure and insulation properties)"}
   :boundary {:lo 0.02 :hi 0.20}}]}
